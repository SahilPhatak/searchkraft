# Database — Railway provides this automatically when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth — generate a strong random string, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# Server
PORT=4000
NODE_ENV=production

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=https://sahilphatak.github.io

# Optional — only needed for AI features (job parsing, candidate matching)
ANTHROPIC_API_KEY=
